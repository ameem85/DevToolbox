<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DevToolbox.App.Views.LogcatToolPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modules="clr-namespace:DevToolbox.Core.Modules;assembly=DevToolbox.Core"
    xmlns:strings="clr-namespace:DevToolbox.App.Resources.Strings"
    xmlns:vm="clr-namespace:DevToolbox.App.ViewModels"
    Title="{x:Static strings:AppStrings.Logcat_PageTitle}"
    x:DataType="vm:LogcatToolViewModel"
    AutomationId="LogcatTool_Page"
    BackgroundColor="#060A12"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Studio Top Bar -->
        <Border
            Grid.Row="0"
            Padding="16, 10"
            BackgroundColor="#0B1120"
            Stroke="#1E293B"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border Padding="8, 4" BackgroundColor="#162033" Stroke="#818CF8" StrokeShape="RoundRectangle 8">
                        <Label FontAttributes="Bold" FontSize="13" Text="📜" TextColor="#818CF8" />
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label
                            AutomationId="LogcatTool_ControlsHeaderLabel"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="LOGCAT &amp; UNIFIED DIAGNOSTIC STREAM"
                            TextColor="#F8FAFC" />
                        <Label
                            AutomationId="LogcatTool_StatusBadgeLabel"
                            FontFamily="monospace"
                            FontSize="11"
                            Text="{Binding StreamStatusBadge}"
                            TextColor="#34D399" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button
                        AutomationId="LogcatTool_StartStreamButton"
                        BackgroundColor="#059669"
                        Command="{Binding StartStreamCommand}"
                        Text="▶ Start Stream"
                        TextColor="White" />
                    <Button
                        AutomationId="LogcatTool_StopStreamButton"
                        BackgroundColor="#7F1D1D"
                        Command="{Binding StopStreamCommand}"
                        Text="⏹ Stop"
                        TextColor="#FCA5A5" />
                    <Button
                        AutomationId="LogcatTool_EmitMarkerButton"
                        BackgroundColor="#0284C7"
                        Command="{Binding EmitMarkerCommand}"
                        Text="📌 QA Checkpoint"
                        TextColor="White" />
                    <Button
                        AutomationId="LogcatTool_ClearBufferButton"
                        BackgroundColor="#162033"
                        BorderColor="#2A3A54"
                        BorderWidth="1"
                        Command="{Binding ClearBufferCommand}"
                        Text="🧹 Clear"
                        TextColor="#E2E8F0" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" AutomationId="LogcatTool_ScrollView">
            <VerticalStackLayout Padding="16, 12" Spacing="12">

                <!-- Filter Bar -->
                <Border Style="{StaticResource StudioCardBorder}">
                    <Grid ColumnDefinitions="Auto, *, *" ColumnSpacing="10">
                        <Picker
                            Grid.Column="0"
                            WidthRequest="110"
                            AutomationId="LogcatTool_LevelPicker"
                            FontFamily="monospace"
                            ItemsSource="{Binding AvailableLevels}"
                            SelectedItem="{Binding SelectedLevel}" />
                        <Entry
                            Grid.Column="1"
                            AutomationId="LogcatTool_TagFilterEntry"
                            FontFamily="monospace"
                            Placeholder="{x:Static strings:AppStrings.Logcat_TagFilterPlaceholder}"
                            Text="{Binding TagFilter}" />
                        <Entry
                            Grid.Column="2"
                            AutomationId="LogcatTool_SearchEntry"
                            FontFamily="monospace"
                            Placeholder="{x:Static strings:AppStrings.Logcat_SearchPlaceholder}"
                            Text="{Binding SearchQuery}" />
                    </Grid>
                </Border>

                <Label
                    AutomationId="LogcatTool_LiveFeedHeaderLabel"
                    FontAttributes="Bold"
                    FontSize="12.5"
                    Text="LIVE TERMINAL LOGCAT FEED (DIRECT IOC STREAM)"
                    TextColor="#94A3B8" />

                <CollectionView
                    AutomationId="LogcatTool_EntriesCollectionView"
                    ItemsSource="{Binding FilteredEntries}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="modules:LogcatEntryRecord">
                            <Border
                                Padding="10, 6"
                                BackgroundColor="#070B14"
                                Stroke="#1E293B"
                                StrokeShape="RoundRectangle 6">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label
                                            AutomationId="LogcatTool_EntryTimestampLabel"
                                            FontFamily="monospace"
                                            FontSize="10.5"
                                            Text="{Binding FormattedTimestamp}"
                                            TextColor="#64748B" />
                                        <Label
                                            AutomationId="LogcatTool_EntryHeaderLabel"
                                            FontAttributes="Bold"
                                            FontFamily="monospace"
                                            FontSize="11"
                                            Text="{Binding HeaderSummary}"
                                            TextColor="#38BDF8" />
                                    </HorizontalStackLayout>
                                    <Label
                                        AutomationId="LogcatTool_EntryMessageLabel"
                                        FontFamily="monospace"
                                        FontSize="11.5"
                                        Text="{Binding Message}"
                                        TextColor="#F8FAFC" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
