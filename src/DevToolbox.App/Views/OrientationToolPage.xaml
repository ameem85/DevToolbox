<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DevToolbox.App.Views.OrientationToolPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:DevToolbox.App.Resources.Strings"
    xmlns:vm="clr-namespace:DevToolbox.App.ViewModels"
    Title="{x:Static strings:AppStrings.Orientation_PageTitle}"
    x:DataType="vm:OrientationToolViewModel"
    AutomationId="OrientationTool_Page"
    BackgroundColor="#060A12"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Studio Top Bar -->
        <Border
            Grid.Row="0"
            Padding="16, 10"
            BackgroundColor="#0B1120"
            Stroke="#1E293B"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border Padding="8, 4" BackgroundColor="#162033" Stroke="#FBBF24" StrokeShape="RoundRectangle 8">
                        <Label FontAttributes="Bold" FontSize="13" Text="🔄" TextColor="#FBBF24" />
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="15" Text="ORIENTATION &amp; DISPLAY STATE CONTROLLER" TextColor="#F8FAFC" />
                        <Label
                            AutomationId="OrientationTool_StatusMessageLabel"
                            FontFamily="monospace"
                            FontSize="11"
                            Text="{Binding StatusMessage}"
                            TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1" Padding="10, 5" BackgroundColor="#070B14" Stroke="#D97706" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                    <Label
                        AutomationId="OrientationTool_CurrentBadgeLabel"
                        FontAttributes="Bold"
                        FontFamily="monospace"
                        FontSize="10.5"
                        Text="{Binding CurrentOrientationBadge}"
                        TextColor="#FBBF24" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" AutomationId="OrientationTool_ScrollView">
            <VerticalStackLayout Padding="16, 12" Spacing="12">

                <!-- Target Execution Scope Card -->
                <Border Style="{StaticResource StudioCardBorder}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                AutomationId="OrientationTool_TargetModeHeaderLabel"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="TARGET EXECUTION SCOPE (ON-DEVICE VS. ADB BRIDGE)"
                                TextColor="#F8FAFC" />
                            <HorizontalStackLayout Spacing="10">
                                <Switch
                                    AutomationId="OrientationTool_RemoteAdbSwitch"
                                    IsToggled="{Binding UseRemoteAdbDevice}"
                                    OnColor="#38BDF8" />
                                <Label
                                    AutomationId="OrientationTool_RemoteAdbLabel"
                                    FontSize="12"
                                    Text="{x:Static strings:AppStrings.Orientation_UseRemoteAdbLabel}"
                                    TextColor="#E2E8F0"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            AutomationId="OrientationTool_RefreshDevicesButton"
                            BackgroundColor="#162033"
                            BorderColor="#2A3A54"
                            BorderWidth="1"
                            Command="{Binding RefreshAdbDevicesCommand}"
                            Text="↻ Refresh ADB Devices"
                            TextColor="#38BDF8"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Force Screen Orientation Override Card -->
                <Border Style="{StaticResource StudioCardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            AutomationId="OrientationTool_QuickControlsHeaderLabel"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="FORCE SCREEN ORIENTATION OVERRIDE"
                            TextColor="#F8FAFC" />

                        <Grid
                            ColumnDefinitions="*, *, *"
                            ColumnSpacing="10"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="8">
                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                AutomationId="OrientationTool_PortraitButton"
                                BackgroundColor="#0284C7"
                                Command="{Binding SetPortraitCommand}"
                                Text="📱 Portrait (0°)"
                                TextColor="White" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                AutomationId="OrientationTool_LandscapeButton"
                                BackgroundColor="#059669"
                                Command="{Binding SetLandscapeCommand}"
                                Text="📺 Landscape (90°)"
                                TextColor="White" />
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                AutomationId="OrientationTool_ReversePortraitButton"
                                BackgroundColor="#4F46E5"
                                Command="{Binding SetReversePortraitCommand}"
                                Text="🙃 Reverse Portrait (180°)"
                                TextColor="White" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                AutomationId="OrientationTool_ReverseLandscapeButton"
                                BackgroundColor="#6D28D9"
                                Command="{Binding SetReverseLandscapeCommand}"
                                Text="🔁 Reverse Landscape (270°)"
                                TextColor="White" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationId="OrientationTool_SensorButton"
                                BackgroundColor="#D97706"
                                Command="{Binding SetSensorCommand}"
                                Text="🧭 Sensor Auto-Rotate"
                                TextColor="White" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                AutomationId="OrientationTool_UnlockButton"
                                BackgroundColor="#162033"
                                BorderColor="#2A3A54"
                                BorderWidth="1"
                                Command="{Binding ResetOrientationCommand}"
                                Text="🔓 Reset / Unlock"
                                TextColor="#E2E8F0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Responsive Display Metrics & Density Presets Card -->
                <Border Style="{StaticResource StudioCardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            AutomationId="OrientationTool_DisplayOverrideHeaderLabel"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="RESPONSIVE DISPLAY METRICS &amp; DENSITY PRESETS"
                            TextColor="#F8FAFC" />

                        <Grid ColumnDefinitions="*, *, *, Auto" ColumnSpacing="8">
                            <Button
                                Grid.Column="0"
                                AutomationId="OrientationTool_PresetPhoneButton"
                                BackgroundColor="#162033"
                                BorderColor="#0284C7"
                                BorderWidth="1"
                                Command="{Binding ApplyPhonePresetCommand}"
                                Text="Phone (1080x2400 @ 420)"
                                TextColor="#38BDF8" />
                            <Button
                                Grid.Column="1"
                                AutomationId="OrientationTool_PresetRuggedButton"
                                BackgroundColor="#162033"
                                BorderColor="#059669"
                                BorderWidth="1"
                                Command="{Binding ApplyRuggedHandheldPresetCommand}"
                                Text="CT47 (1080x2160 @ 480)"
                                TextColor="#34D399" />
                            <Button
                                Grid.Column="2"
                                AutomationId="OrientationTool_PresetTabletButton"
                                BackgroundColor="#162033"
                                BorderColor="#4F46E5"
                                BorderWidth="1"
                                Command="{Binding ApplyTabletPresetCommand}"
                                Text="Tablet (2560x1600 @ 320)"
                                TextColor="#818CF8" />
                            <Button
                                Grid.Column="3"
                                AutomationId="OrientationTool_ResetDisplayButton"
                                BackgroundColor="#7F1D1D"
                                Command="{Binding ResetDisplayPresetCommand}"
                                Text="Reset Metrics"
                                TextColor="#FCA5A5" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
