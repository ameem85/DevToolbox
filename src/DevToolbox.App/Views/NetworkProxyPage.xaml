<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DevToolbox.App.Views.NetworkProxyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:DevToolbox.Core.Abstractions.Services;assembly=DevToolbox.Core"
    xmlns:strings="clr-namespace:DevToolbox.App.Resources.Strings"
    xmlns:vm="clr-namespace:DevToolbox.App.ViewModels"
    Title="{x:Static strings:AppStrings.Proxy_PageTitle}"
    x:DataType="vm:NetworkProxyViewModel"
    AutomationId="NetworkProxy_Page"
    BackgroundColor="#060A12"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Studio Top Bar -->
        <Border
            Grid.Row="0"
            Padding="16, 10"
            BackgroundColor="#0B1120"
            Stroke="#1E293B"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border Padding="8, 4" BackgroundColor="#162033" Stroke="#34D399" StrokeShape="RoundRectangle 8">
                        <Label FontAttributes="Bold" FontSize="13" Text="🌐" TextColor="#34D399" />
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="15" Text="MITM NETWORK PROXY &amp; MOCK ENGINE" TextColor="#F8FAFC" />
                        <Label
                            AutomationId="NetworkProxy_StatusBannerLabel"
                            FontFamily="monospace"
                            FontSize="11"
                            Text="{Binding StatusBanner}"
                            TextColor="#34D399" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button
                        AutomationId="NetworkProxy_StartButton"
                        BackgroundColor="#059669"
                        Command="{Binding StartProxyCommand}"
                        Text="▶ Start Proxy"
                        TextColor="White" />
                    <Button
                        AutomationId="NetworkProxy_StopButton"
                        BackgroundColor="#7F1D1D"
                        Command="{Binding StopProxyCommand}"
                        Text="⏹ Stop"
                        TextColor="#FCA5A5" />
                    <Button
                        AutomationId="NetworkProxy_AdbReverseButton"
                        BackgroundColor="#4F46E5"
                        Command="{Binding BindAdbReverseTunnelCommand}"
                        Text="⇄ ADB Reverse :8888"
                        TextColor="White" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" AutomationId="NetworkProxy_ScrollView">
            <VerticalStackLayout Padding="16, 12" Spacing="12">

                <!-- Listener & Certificate Authority Card -->
                <Border Style="{StaticResource StudioCardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                AutomationId="NetworkProxy_ListenerSectionLabel"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="HTTP/HTTPS TLS 1.3 INTERCEPTOR &amp; ROOT CA PROVISIONING"
                                TextColor="#F8FAFC" />
                            <Label
                                Grid.Column="1"
                                AutomationId="NetworkProxy_CertificateStatusLabel"
                                FontFamily="monospace"
                                FontSize="10.5"
                                Text="{Binding CertificateStatusBanner}"
                                TextColor="#38BDF8" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                            <Label
                                Grid.Column="0"
                                AutomationId="NetworkProxy_PortLabel"
                                FontSize="12"
                                Text="Port:"
                                TextColor="#94A3B8"
                                VerticalOptions="Center" />
                            <Entry
                                Grid.Column="1"
                                WidthRequest="84"
                                AutomationId="NetworkProxy_PortEntry"
                                FontFamily="monospace"
                                Keyboard="Numeric"
                                Text="{Binding ListenPortText}" />
                            <Button
                                Grid.Column="3"
                                AutomationId="NetworkProxy_ExportRootCaButton"
                                BackgroundColor="#162033"
                                BorderColor="#0284C7"
                                BorderWidth="1"
                                Command="{Binding ExportRootCaCommand}"
                                Text="Export Root CA (.cer/.pem)"
                                TextColor="#38BDF8" />
                            <Button
                                Grid.Column="4"
                                AutomationId="NetworkProxy_PushRootCaAdbButton"
                                BackgroundColor="#162033"
                                BorderColor="#4F46E5"
                                BorderWidth="1"
                                Command="{Binding PushRootCaViaAdbCommand}"
                                Text="Push CA via ADB"
                                TextColor="#818CF8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Traffic Simulator & Rule Creator Row -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource StudioCardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                AutomationId="NetworkProxy_SimulatorSectionLabel"
                                FontAttributes="Bold"
                                FontSize="12.5"
                                Text="TRAFFIC &amp; FAULT SIMULATOR"
                                TextColor="#F8FAFC" />
                            <HorizontalStackLayout Spacing="6">
                                <Button
                                    AutomationId="NetworkProxy_SimulateProfileButton"
                                    BackgroundColor="#0284C7"
                                    Command="{Binding SimulateProfileRequestCommand}"
                                    Text="GET /profile (200)"
                                    TextColor="White" />
                                <Button
                                    AutomationId="NetworkProxy_SimulateCheckoutButton"
                                    BackgroundColor="#B91C1C"
                                    Command="{Binding SimulateCheckoutFaultCommand}"
                                    Text="POST /checkout (503)"
                                    TextColor="White" />
                                <Button
                                    AutomationId="NetworkProxy_SimulateCatalogButton"
                                    BackgroundColor="#D97706"
                                    Command="{Binding SimulateCatalogRewriteCommand}"
                                    Text="GET /catalog (Rewrite)"
                                    TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StudioCardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                AutomationId="NetworkProxy_AddRuleHeaderLabel"
                                FontAttributes="Bold"
                                FontSize="12.5"
                                Text="NEW MOCK / REWRITE / FAULT RULE"
                                TextColor="#F8FAFC" />
                            <Grid ColumnDefinitions="*, *, Auto, Auto" ColumnSpacing="6">
                                <Entry
                                    Grid.Column="0"
                                    AutomationId="NetworkProxy_NewRuleNameEntry"
                                    Placeholder="Rule Name"
                                    Text="{Binding NewRuleName}" />
                                <Entry
                                    Grid.Column="1"
                                    AutomationId="NetworkProxy_NewRuleUrlEntry"
                                    FontFamily="monospace"
                                    Placeholder="*/api/v1/orders*"
                                    Text="{Binding NewRuleUrlPattern}" />
                                <Picker
                                    Grid.Column="2"
                                    WidthRequest="130"
                                    AutomationId="NetworkProxy_RuleTypePicker"
                                    ItemsSource="{Binding AvailableRuleTypes}"
                                    SelectedItem="{Binding SelectedRuleType}" />
                                <Button
                                    Grid.Column="3"
                                    AutomationId="NetworkProxy_AddRuleButton"
                                    BackgroundColor="#0284C7"
                                    Command="{Binding AddRuleCommand}"
                                    Text="+ Add"
                                    TextColor="White" />
                            </Grid>
                            <Entry
                                AutomationId="NetworkProxy_NewRulePayloadEntry"
                                FontFamily="monospace"
                                Placeholder="{x:Static strings:AppStrings.Proxy_NewRulePayloadPlaceholder}"
                                Text="{Binding NewRulePayload}"
                                TextColor="#38BDF8" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Active Rules List -->
                <Label
                    AutomationId="NetworkProxy_RulesHeaderLabel"
                    FontAttributes="Bold"
                    FontSize="12.5"
                    Text="ACTIVE INTERCEPTION RULES"
                    TextColor="#94A3B8" />

                <CollectionView
                    AutomationId="NetworkProxy_RulesCollectionView"
                    ItemsSource="{Binding Rules}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MockRuleItemViewModel">
                            <Border
                                Padding="12, 8"
                                BackgroundColor="#0F172A"
                                Stroke="#1E293B"
                                StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                    <Switch
                                        Grid.Column="0"
                                        AutomationId="NetworkProxy_RuleEnabledSwitch"
                                        IsToggled="{Binding IsEnabled}"
                                        OnColor="#34D399"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label
                                                AutomationId="NetworkProxy_RuleNameLabel"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Text="{Binding Name}"
                                                TextColor="#F8FAFC" />
                                            <Label
                                                AutomationId="NetworkProxy_RuleSummaryLabel"
                                                FontFamily="monospace"
                                                FontSize="11"
                                                Text="{Binding Summary}"
                                                TextColor="#38BDF8"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label
                                            AutomationId="NetworkProxy_RulePayloadLabel"
                                            FontFamily="monospace"
                                            FontSize="10.5"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding PayloadPreview}"
                                            TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="2"
                                        AutomationId="NetworkProxy_DeleteRuleButton"
                                        BackgroundColor="#7F1D1D"
                                        Command="{Binding DeleteCommand}"
                                        Text="Delete"
                                        TextColor="#FCA5A5"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Captured Traffic Stream -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label
                        Grid.Column="0"
                        AutomationId="NetworkProxy_TrafficHeaderLabel"
                        FontAttributes="Bold"
                        FontSize="12.5"
                        Text="LIVE CAPTURED HTTP/HTTPS TRAFFIC (DIRECT IOC STREAM)"
                        TextColor="#94A3B8"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        AutomationId="NetworkProxy_ClearTrafficButton"
                        BackgroundColor="#162033"
                        BorderColor="#2A3A54"
                        BorderWidth="1"
                        Command="{Binding ClearTrafficCommand}"
                        Text="🧹 Clear Traffic"
                        TextColor="#E2E8F0" />
                </Grid>

                <CollectionView
                    AutomationId="NetworkProxy_TrafficCollectionView"
                    ItemsSource="{Binding CapturedTraffic}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:CapturedTrafficEntry">
                            <Border
                                Padding="12, 8"
                                BackgroundColor="#070B14"
                                Stroke="#1E293B"
                                StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label
                                            AutomationId="NetworkProxy_TrafficMethodLabel"
                                            FontAttributes="Bold"
                                            FontFamily="monospace"
                                            FontSize="11.5"
                                            Text="{Binding Method}"
                                            TextColor="#38BDF8" />
                                        <Label
                                            AutomationId="NetworkProxy_TrafficStatusLabel"
                                            FontAttributes="Bold"
                                            FontFamily="monospace"
                                            FontSize="11.5"
                                            Text="{Binding StatusCode}"
                                            TextColor="#34D399" />
                                        <Label
                                            AutomationId="NetworkProxy_TrafficUrlLabel"
                                            FontFamily="monospace"
                                            FontSize="11.5"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Url}"
                                            TextColor="#F8FAFC" />
                                    </HorizontalStackLayout>
                                    <Label
                                        AutomationId="NetworkProxy_TrafficRuleMatchLabel"
                                        FontFamily="monospace"
                                        FontSize="10.5"
                                        Text="{Binding MatchedRuleName}"
                                        TextColor="#FBBF24" />
                                    <Label
                                        AutomationId="NetworkProxy_TrafficResponsePreviewLabel"
                                        FontFamily="monospace"
                                        FontSize="10.5"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding ResponsePreview}"
                                        TextColor="#94A3B8" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
